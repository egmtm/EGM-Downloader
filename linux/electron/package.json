{
  "name": "egm-downloader",
  "version": "0.99.10",
  "description": "EGM Downloader \u2014 download videos from 1000+ sites",
  "main": "main.js",
  "author": "www.egerena.com",
  "license": "AGPL-3.0",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --linux",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^42.1.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.egerena.egm-downloader",
    "productName": "EGM Downloader",
    "afterPack": "build/after-pack.js",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "!node_modules/**/*",
      "!**/*.md",
      "!**/*.map",
      "!**/__tests__/**",
      "!**/test/**",
      "!**/tests/**"
    ],
    "extraResources": [
      {
        "from": "../",
        "to": "app",
        "filter": [
          "app.py",
          "templates/**",
          "requirements.txt"
        ]
      },
      {
        "from": "../../static",
        "to": "app/static",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../python",
        "to": "python",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../../static/icon-512.png",
      "category": "Network",
      "executableName": "egm-downloader",
      "artifactName": "EGM Downloader.AppImage"
    },
    "electronLanguages": [
      "en"
    ],
    "extraFiles": [
      {
        "from": "../../static/icon-512.png",
        "to": "usr/share/icons/hicolor/512x512/apps/egm-downloader.png"
      }
    ]
  }
}
