#!/usr/bin/env bash
# EGM Downloader — pre-commit hook
# Runs the version sync + template parity validator, then the full test suite.
# Catches drift and regressions before they reach CI or review.
#
# Install once per clone:
#   git config core.hooksPath .githooks
#
# Requires: pip install flask mutagen cryptography pytest

set -e

echo "⏳ Running version sync + parity check..."
python3 scripts/validate-version-sync.py
echo "✅ Version sync clean"

echo ""
echo "⏳ Running test suite..."
cd tests
EGM_API_TOKEN=ci-test-token-not-secret python3 -m pytest . -q --tb=short
echo "✅ Tests passed"
